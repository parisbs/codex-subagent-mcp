{
  "name": "codex-subagent-mcp",
  "version": "0.1.0",
  "description": "Local MCP server that delegates coding tasks to the OpenAI Codex CLI, with explicit model and reasoning-effort selection.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "anthropic",
    "codex",
    "codex-cli",
    "openai",
    "subagent",
    "orchestration",
    "multi-model",
    "ai-agent"
  ],
  "homepage": "https://github.com/parisbs/codex-subagent-mcp#readme",
  "bugs": {
    "url": "https://github.com/parisbs/codex-subagent-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parisbs/codex-subagent-mcp.git"
  },
  "license": "MIT",
  "author": "Paris Niarfe Baltazar Salguero",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "codex-subagent": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "start": "node build/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
